From a9067080fd7ef3a27e0a17bfc66f5676284af713 Mon Sep 17 00:00:00 2001
From: Arian <arian.kulmer@web.de>
Date: Tue, 15 Oct 2024 19:06:16 +0200
Subject: [PATCH 5/6] Force enable StartActivityWhenLocked

MIUI sends this with the intent, but on AOSP we don't get this parameter

[Ported to sweet MiuiCamera (V14.0.9.0.TKFMIXM), where the method is
 CameraIntentManager.isStartActivityWhenLocked()]
---
 smali/com/android/camera/CameraIntentManager.smali | 3 +++
 1 file changed, 3 insertions(+)

diff --git a/smali/com/android/camera/CameraIntentManager.smali b/smali/com/android/camera/CameraIntentManager.smali
index ca7ca27..10ac3a5 100644
--- a/smali/com/android/camera/CameraIntentManager.smali
+++ b/smali/com/android/camera/CameraIntentManager.smali
@@ -97,10 +97,13 @@
     .line 1
     invoke-virtual {p0, v1, v0}, Landroid/content/Intent;->getBooleanExtra(Ljava/lang/String;Z)Z
 
     move-result p0
 
+    # MIUI's keyguard sends this extra, AOSP SystemUI doesn't
+    const/4 p0, 0x1
+
     .line 2
     sget-object v0, Lcom/android/camera/CameraIntentManager;->TAG:Ljava/lang/String;
 
     new-instance v1, Ljava/lang/StringBuilder;
 
